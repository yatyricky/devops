serverAddr = "{{ frps_server_addr }}"
serverPort = {{ frps_bind_port }}

transport.tls.enable = true

auth.method = "token"
auth.tokenSource.type = "file"
auth.tokenSource.file.path = "{{ frp_token_path }}"

# Single proxy per BS: exposes local nginx (:80) under {{ bsi }}.{{ frps_subdomain_host }}
[[proxies]]
name = "{{ bsi }}-http"
type = "http"
localIP = "127.0.0.1"
localPort = 80
subdomain = "{{ bsi }}"
transport.useEncryption = true
