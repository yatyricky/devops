[Unit]
Description=kids-ledger 家庭账本
After=network.target

[Service]
Type=simple
User={{ kl_user }}
Group={{ kl_user }}
WorkingDirectory={{ kl_deploy_dir }}
ExecStart={{ kl_deploy_dir }}/current/start.sh
Restart=on-failure
RestartSec=3

# start.sh 内 exec node 前台运行；数据库写入 {{ kl_deploy_dir }}/shared/data
ReadWritePaths={{ kl_deploy_dir }}

[Install]
WantedBy=multi-user.target
