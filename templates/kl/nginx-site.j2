# kids-ledger nginx 站点（原 nginx/kl.nefandfriends.com.conf）
# 80 → 127.0.0.1:{{ kl_port }}；HTTPS 用 certbot --nginx 升级（见 README）
server {
    listen 80;
    server_name {{ kl_domain | default('kl.example.com') }};

    client_max_body_size 1m;

    access_log /var/log/nginx/kl.access.log;
    error_log  /var/log/nginx/kl.error.log;

    location / {
        proxy_pass http://127.0.0.1:{{ kl_port }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
