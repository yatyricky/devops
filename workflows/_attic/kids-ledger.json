{
  "name": "kids-ledger",
  "title": "家庭账本（Fastify + SQLite + Vue 3）",
  "version": 1,
  "repoDir": "C:/Users/yatyr/workspace/kids-ledger",
  "nodes": [
    {
      "id": "env1",
      "type": "env.file",
      "position": [
        40,
        300
      ],
      "data": {
        "envFile": "kids-ledger.env",
        "schema": {
          "SERVER_TYPE": "test",
          "REMOTE_HOST": "host.example.com",
          "REMOTE_USER": "deploy",
          "REMOTE_HOST_FINGERPRINT": "",
          "REMOTE_KEY_FILE": "",
          "DEPLOY_DIR": "/opt/kids-ledger",
          "DOMAIN": "kl.example.com",
          "SERVICE_NAME": "kids-ledger",
          "SERVICE_USER": "www-data",
          "APP_PORT": 3050,
          "NODE_BIN": "/usr/bin/node"
        }
      }
    },
    {
      "id": "inRef",
      "type": "task.input",
      "position": [
        40,
        100
      ],
      "data": {
        "name": "ref",
        "label": "Git ref（空 = HEAD）",
        "fallback": ""
      }
    },
    {
      "id": "git1",
      "type": "git.ref",
      "position": [
        300,
        300
      ],
      "data": {
        "repoDir": "C:/Users/yatyr/workspace/kids-ledger",
        "prefix": "kids-ledger"
      }
    },
    {
      "id": "build1",
      "type": "cmd.exec",
      "position": [
        560,
        300
      ],
      "data": {
        "commands": "pnpm install --frozen-lockfile\npnpm build"
      }
    },
    {
      "id": "stage1",
      "type": "stage.copy",
      "position": [
        820,
        300
      ],
      "data": {
        "entries": [
          {
            "from": "server",
            "to": "server"
          },
          {
            "from": "shared",
            "to": "shared"
          },
          {
            "from": "dist",
            "to": "dist"
          },
          {
            "from": "start.sh",
            "to": "start.sh"
          },
          {
            "from": "package.json",
            "to": "package.json"
          },
          {
            "from": "package-lock.json",
            "to": "package-lock.json"
          }
        ],
        "excludes": [
          "node_modules"
        ]
      }
    },
    {
      "id": "pack1",
      "type": "tar.pack",
      "position": [
        1080,
        300
      ],
      "data": {
        "entries": [
          "server",
          "shared",
          "dist",
          "start.sh",
          "package.json",
          "package-lock.json"
        ],
        "prefix": "kids-ledger"
      }
    },
    {
      "id": "ssh1",
      "type": "ssh.session",
      "position": [
        40,
        700
      ],
      "data": {}
    },
    {
      "id": "fieldDD",
      "type": "field.get",
      "position": [
        300,
        980
      ],
      "data": {
        "key": "DEPLOY_DIR"
      }
    },
    {
      "id": "fieldSU",
      "type": "field.get",
      "position": [
        420,
        1060
      ],
      "data": {
        "key": "SERVICE_USER"
      }
    },
    {
      "id": "fieldSN",
      "type": "field.get",
      "position": [
        300,
        900
      ],
      "data": {
        "key": "SERVICE_NAME"
      }
    },
    {
      "id": "fmtCur",
      "type": "string.format",
      "position": [
        560,
        980
      ],
      "data": {
        "format": "{{env.DEPLOY_DIR}}/current"
      }
    },
    {
      "id": "fmtUp",
      "type": "string.format",
      "position": [
        1080,
        440
      ],
      "data": {
        "format": "{{env.DEPLOY_DIR}}/build/{{name}}"
      }
    },
    {
      "id": "pre1",
      "type": "ssh.exec",
      "position": [
        1340,
        300
      ],
      "data": {
        "command": "mkdir -p {{env.DEPLOY_DIR}}/build {{env.DEPLOY_DIR}}/releases {{env.DEPLOY_DIR}}/state/data",
        "useSudo": true
      }
    },
    {
      "id": "up1",
      "type": "ssh.upload",
      "position": [
        1600,
        300
      ],
      "data": {}
    },
    {
      "id": "ext1",
      "type": "remote.extract",
      "position": [
        1860,
        300
      ],
      "data": {
        "expect": [
          "server/index.js",
          "start.sh",
          "dist/index.html",
          "shared/palettes.js"
        ]
      }
    },
    {
      "id": "deps1",
      "type": "ssh.exec",
      "position": [
        2120,
        300
      ],
      "data": {
        "command": "cd {{rel}} && (pnpm install --prod --frozen-lockfile || pnpm install --prod --no-frozen-lockfile)",
        "useSudo": true,
        "loginShell": true
      }
    },
    {
      "id": "link1",
      "type": "ssh.exec",
      "position": [
        2380,
        300
      ],
      "data": {
        "command": "chmod +x {{rel}}/start.sh && ln -sfn {{env.DEPLOY_DIR}}/state/data {{rel}}/data && { [ -f {{env.DEPLOY_DIR}}/state/config.json ] && ln -sfn {{env.DEPLOY_DIR}}/state/config.json {{rel}}/config.json || true; }",
        "useSudo": true,
        "loginShell": false
      }
    },
    {
      "id": "chown1",
      "type": "remote.chown",
      "position": [
        2640,
        300
      ],
      "data": {}
    },
    {
      "id": "linkCur",
      "type": "remote.symlink",
      "position": [
        2900,
        300
      ],
      "data": {}
    },
    {
      "id": "svc1",
      "type": "remote.service",
      "position": [
        3160,
        300
      ],
      "data": {
        "action": "restart"
      }
    },
    {
      "id": "hc1",
      "type": "ssh.exec",
      "position": [
        3420,
        300
      ],
      "data": {
        "command": "for i in $(seq 1 10); do systemctl is-active --quiet {{env.SERVICE_NAME}} && curl -fsS http://127.0.0.1:{{env.APP_PORT}}/ >/dev/null 2>&1 && echo healthy && exit 0; sleep 2; done; echo healthcheck failed; exit 1",
        "useSudo": false,
        "loginShell": true
      }
    },
    {
      "id": "clean1",
      "type": "ssh.exec",
      "position": [
        3680,
        300
      ],
      "data": {
        "command": "cd {{env.DEPLOY_DIR}}/releases && ls -1 | grep -v \"\\.tgz$\" | sort | head -n -5 | xargs -r rm -rf --",
        "useSudo": true,
        "loginShell": false
      }
    },
    {
      "id": "inRel",
      "type": "task.input",
      "position": [
        1340,
        700
      ],
      "data": {
        "name": "release",
        "label": "目标 release 名（见 status 输出）",
        "fallback": ""
      }
    },
    {
      "id": "fmtRel",
      "type": "string.format",
      "position": [
        1600,
        700
      ],
      "data": {
        "format": "{{env.DEPLOY_DIR}}/releases/{{rel}}"
      }
    },
    {
      "id": "chk1",
      "type": "ssh.exec",
      "position": [
        1860,
        700
      ],
      "data": {
        "command": "test -d {{env.DEPLOY_DIR}}/releases/{{rel}} || { echo 'release not found: {{rel}}'; exit 1; }",
        "useSudo": false,
        "loginShell": false
      }
    },
    {
      "id": "chk2",
      "type": "ssh.exec",
      "position": [
        2120,
        700
      ],
      "data": {
        "command": "test -f {{env.DEPLOY_DIR}}/releases/{{rel}}/server/index.js && test -f {{env.DEPLOY_DIR}}/releases/{{rel}}/start.sh && test -f {{env.DEPLOY_DIR}}/releases/{{rel}}/dist/index.html || { echo 'release layout incomplete'; exit 1; }",
        "useSudo": false,
        "loginShell": false
      }
    },
    {
      "id": "symlinkR",
      "type": "remote.symlink",
      "position": [
        2380,
        700
      ],
      "data": {}
    },
    {
      "id": "st1",
      "type": "ssh.exec",
      "position": [
        1340,
        980
      ],
      "data": {
        "command": "systemctl is-active {{env.SERVICE_NAME}} || true\nreadlink -f {{env.DEPLOY_DIR}}/current || true\nls -1t {{env.DEPLOY_DIR}}/releases 2>/dev/null | head -8\ndf -h {{env.DEPLOY_DIR}} | tail -1\n{{env.NODE_BIN}} -v 2>/dev/null || node -v\ncurl -s -o /dev/null -w 'local http status: %{http_code}\\n' http://127.0.0.1:{{env.APP_PORT}}/ || true",
        "useSudo": false,
        "loginShell": true
      }
    },
    {
      "id": "mkOps",
      "type": "ssh.exec",
      "position": [
        1340,
        1240
      ],
      "data": {
        "command": "mkdir -p {{env.DEPLOY_DIR}}/ops /etc/nginx/sites-available /etc/nginx/sites-enabled",
        "useSudo": true,
        "loginShell": false
      }
    },
    {
      "id": "ngR",
      "type": "template.render",
      "position": [
        1600,
        1160
      ],
      "data": {
        "template": "./tpl/kids-ledger/nginx-site.conf",
        "outputName": "nginx-site.conf"
      }
    },
    {
      "id": "fmtOpsNg",
      "type": "string.format",
      "position": [
        1600,
        1080
      ],
      "data": {
        "format": "{{env.DEPLOY_DIR}}/ops/nginx-site.conf"
      }
    },
    {
      "id": "ngU",
      "type": "ssh.upload",
      "position": [
        1860,
        1160
      ],
      "data": {}
    },
    {
      "id": "svcR",
      "type": "template.render",
      "position": [
        1600,
        1400
      ],
      "data": {
        "template": "./tpl/kids-ledger/kids-ledger.service",
        "outputName": "kids-ledger.service"
      }
    },
    {
      "id": "fmtOpsSvc",
      "type": "string.format",
      "position": [
        1600,
        1480
      ],
      "data": {
        "format": "{{env.DEPLOY_DIR}}/ops/kids-ledger.service"
      }
    },
    {
      "id": "svcU",
      "type": "ssh.upload",
      "position": [
        1860,
        1400
      ],
      "data": {}
    },
    {
      "id": "installOps",
      "type": "ssh.exec",
      "position": [
        2120,
        1240
      ],
      "data": {
        "command": "install -m 644 {{ng}} /etc/nginx/sites-available/{{env.DOMAIN}}.conf && ln -sf /etc/nginx/sites-available/{{env.DOMAIN}}.conf /etc/nginx/sites-enabled/{{env.DOMAIN}}.conf && install -m 644 {{svc}} /etc/systemd/system/{{env.SERVICE_NAME}}.service && systemctl daemon-reload && nginx -t && systemctl reload nginx && echo 'apply-config done'",
        "useSudo": true,
        "loginShell": false
      }
    }
  ],
